<?xml version="1.0" encoding="utf-8"?>

<project ptx-version="2">
  <targets>

    <target name="web" format="html" publication="publication.xml" source="main.ptx">
      <stringparams html.css.extra="external/css/interactives.css"/>
    </target>

    <target name="runestone" format="html" platform="runestone">
      <stringparams html.css.extra="external/css/interactives.css"/>
    </target>

    <target name="print" format="pdf"/>

  </targets>
</project>