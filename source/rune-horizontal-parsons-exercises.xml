<!-- Split out of rune.xml for the sample "Runestone Interactives" chapter -->
<section xml:id="sec-horizontal-parsons-exercises">
    <title>Horizontal Parsons Exercises</title>

    <observation>
        <p>
            No known accessibility issues.
        </p>

        <p>
            Last WAVE review: 2026-09-03
        </p>

        <p>
