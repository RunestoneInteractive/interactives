<?xml version="1.0" encoding="UTF-8" ?>

<!-- Split out of rune.xml for the sample "Runestone Interactives" chapter -->
<section xml:id="sec-select-exercises">
    <title>Select Exercises</title>
    
    <observation>
        <p>
            Known accessibility issues:
            <ul>
                <li>Selecting an alternate format does not announce new content.</li>
                <li>
                    Content for the alternate format is placed out of the visual order. You can reach it with tab, but it is not clear where it is located in the visual order.
                </li>
            </ul>
        </p>

        <p>
            Last WAVE review: 2026-10-30.
        </p>

        <p>
            Last screen reader review: 2026-10-30
        </p>
        
        <p>
            Github issues:
            <ul>
                <li><url href="https://github.com/RunestoneInteractive/rs/issues/15616457">#1645</url></li>
            </ul>
        </p>
    </observation>

    <!-- Select grades first alwys, others to view -->
    <exercise label="toggle-first">
        <title>Grade First Question</title>

        <select grade="first" questions="true-false-one multiple-choice-one"/>
    </exercise>
    <!-- Select grades any one reader chooses -->
    <exercise label="toggle-any">
        <title>Grade Any Question</title>

        <select grade="any" questions="true-false-one multiple-choice-one"/>
    </exercise>
</section>